{
  "$comment": "Single source of truth for pr-self-review: which skills review which files. Read by collect-diff.mjs; explained in references/routing.md. Globs: ** any depth, * within a segment, {a,b} alternatives.",
  "version": 1,
  "baseRefs": ["origin/main", "main"],
  "excluded": [
    "server/clones/**",
    "temp/**",
    "**/node_modules",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**"
  ],
  "generated": [
    {
      "id": "migrations",
      "globs": ["server/src/db/migrations/**"],
      "note": "generated by `pnpm db:generate`; never hand-edited"
    },
    {
      "id": "lockfiles",
      "globs": [
        "client/pnpm-lock.yaml",
        "server/pnpm-lock.yaml",
        "reviewer-core/package-lock.json",
        "e2e/package-lock.json"
      ],
      "note": "regenerate with the package's own manager"
    }
  ],
  "packages": {
    "server": {
      "dir": "server",
      "checks": [
        { "id": "typecheck", "cmd": "pnpm typecheck" },
        { "id": "lint", "cmd": "pnpm lint" },
        { "id": "test:unit", "cmd": "pnpm test:unit" },
        { "id": "arch", "cmd": "pnpm arch" }
      ]
    },
    "client": {
      "dir": "client",
      "checks": [
        { "id": "typecheck", "cmd": "pnpm typecheck" },
        { "id": "lint", "cmd": "pnpm lint" },
        { "id": "test", "cmd": "pnpm test" }
      ]
    },
    "reviewer-core": {
      "dir": "reviewer-core",
      "checks": [
        { "id": "typecheck", "cmd": "npm run typecheck" },
        { "id": "lint", "cmd": "npm run lint" },
        { "id": "test", "cmd": "npm test" }
      ]
    },
    "e2e": {
      "dir": "e2e",
      "checks": [
        { "id": "typecheck", "cmd": "npm run typecheck" },
        { "id": "lint", "cmd": "npm run lint" }
      ]
    }
  },
  "extraChecks": [
    {
      "id": "shared-contracts",
      "when": ["server/src/vendor/shared/**", "client/src/vendor/shared/**"],
      "cmd": "./scripts/shared-contracts.sh check",
      "dir": "."
    }
  ],
  "rules": [
    {
      "id": "client-src",
      "globs": ["client/src/**/*.{ts,tsx}"],
      "ignore": ["client/src/vendor/**", "**/*.test.{ts,tsx}"],
      "skills": ["frontend-architecture", "react-best-practices"]
    },
    {
      "id": "client-app-router",
      "globs": ["client/src/app/**/*.{ts,tsx}"],
      "ignore": ["**/*.test.{ts,tsx}"],
      "skills": ["next-best-practices"]
    },
    {
      "id": "client-i18n",
      "globs": ["client/messages/**/*.json"],
      "skills": ["frontend-architecture"]
    },
    {
      "id": "client-tests",
      "globs": ["client/**/*.test.{ts,tsx}", "client/test/**/*.{ts,tsx}"],
      "ignore": ["**/node_modules/**"],
      "skills": ["react-testing-library"]
    },
    {
      "id": "server-app",
      "globs": [
        "server/src/{modules,platform,adapters}/**/*.ts",
        "server/src/*.ts"
      ],
      "ignore": ["**/*.test.ts"],
      "skills": ["onion-architecture", "fastify-best-practices"]
    },
    {
      "id": "server-data",
      "globs": [
        "server/src/modules/**/repository.ts",
        "server/src/modules/**/repository/**/*.ts",
        "server/src/db/**/*.ts"
      ],
      "ignore": ["server/src/db/migrations/**", "**/*.test.ts"],
      "skills": ["drizzle-orm-patterns"]
    },
    {
      "id": "server-schema",
      "globs": ["server/src/db/schema.ts", "server/src/db/schema/**/*.ts"],
      "skills": ["postgresql-table-design"]
    },
    {
      "id": "shared-contracts-server",
      "globs": ["server/src/vendor/shared/**/*.ts"],
      "skills": ["zod", "onion-architecture"]
    },
    {
      "id": "shared-contracts-client",
      "globs": ["client/src/vendor/shared/**/*.ts"],
      "skills": ["zod"]
    },
    {
      "id": "reviewer-core",
      "globs": ["reviewer-core/src/**/*.ts"],
      "ignore": ["**/*.test.ts"],
      "skills": ["typescript-expert", "zod"]
    },
    {
      "id": "security-surface",
      "globs": [
        "{client,server,reviewer-core,e2e}/**/*.{ts,tsx,mjs,js,cjs}",
        "{client,server,reviewer-core,e2e}/package.json",
        "server/.env.example",
        ".github/workflows/**",
        "docker-compose.yml",
        "scripts/**"
      ],
      "ignore": [
        "**/*.test.{ts,tsx}",
        "client/src/vendor/**",
        "**/node_modules/**"
      ],
      "skills": ["security"]
    }
  ],
  "nonReviewSkills": {
    "mermaid-diagram": "authoring aid, not a review rubric",
    "engineering-insights": "documentation workflow, not a review rubric",
    "devdigest-demo": "demo-video conventions, not a review rubric",
    "pr-self-review": "this skill"
  },
  "correctnessReviewer": {
    "note": "One extra reviewer always reads the whole reviewable diff for logic bugs; it is the only reviewer for files no rule matches.",
    "model": "sonnet"
  }
}
