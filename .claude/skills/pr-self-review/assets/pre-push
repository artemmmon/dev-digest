#!/bin/sh
# git pre-push hook installed by scripts/install-hooks.sh.
# Blocks the push of the checked-out branch unless pr-self-review left a fresh PASS verdict.
# Human override: PR_SELF_REVIEW_OVERRIDE="<reason>" git push
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
gate="$root/.claude/skills/pr-self-review/assets/gate-check.mjs"
[ -f "$gate" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "pr-self-review: node not found, gate skipped" >&2; exit 0; }
exec node "$gate" git-hook "$@"
